# ---------------------------------------------------------------------------
# MindHack.in configuration
#
# Copy to .env (local) and set the same keys in your Vercel/Netlify project
# settings for production. Every value below is read at build/render time by
# lib/env.js — nothing is hardcoded in the source.
#
#   Local dev:  SITE_URL=http://localhost:3000/
#   Production: SITE_URL=https://mindhack.in/
#
# Note: SITE_URL must end with a trailing slash.
# ---------------------------------------------------------------------------

SITE_URL=http://localhost:3000/

# External host serving the playable game iframes.
IFRAME_LINK=https://mindhack-in.github.io/mindhack.in.frontend/iframes/

# External host serving game artwork and other static media.
DYNAMIC_RESOURCE=https://mindhack-in.github.io/mindhack.in.dynamic/dynamic/

# Site logo (used in the sidebar, Open Graph tags and Organization schema).
LOGO_URL=https://mindhack-in.github.io/mindhack.in.dynamic/logo.png

# Shown on the contact, privacy and terms pages.
SUPPORT_EMAIL=support@mindhack.in

# Backend used by the login / signup modal.
API_BASE_URL=https://mindhack-in-backend-137262061877.asia-south1.run.app

# Google Analytics 4 measurement ID. Leave blank to disable analytics.
GA_MEASUREMENT_ID=G-9RC3CF2CZ3

# Site-wide identity strings.
SITE_NAME=MindHack
SITE_LOCALE=en_IN

# Contact form endpoint (e.g. a Formspree form URL). Leave blank and the form
# disables itself and points visitors at SUPPORT_EMAIL instead of silently
# dropping their message.
CONTACT_FORM_ENDPOINT=
